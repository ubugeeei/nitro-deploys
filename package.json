{
  "name": "nitro-deploys",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "build:aws-lambda-web": "NITRO_PRESET=aws-lambda-web vite build",
    "deploy:aws-lambda-web": "pnpm build:aws-lambda-web && aws lambda-web deploy --name nitro-deploys --region ap-northeast-1 --code .output --entry-point server/index.mjs --runtime nodejs24.x --endpoint-name dev --endpoint-type HomeRegion --auth-type ApplicationManaged --create",
    "dev": "vite dev",
    "lint": "oxlint && oxfmt --check",
    "fmt": "oxlint --fix && oxfmt",
    "readme": "automd && pnpm fmt",
    "test": "pnpm lint",
    "test:aws-lambda-web": "node scripts/smoke-lambda-web.ts",
    "validate": "node scripts/validate.ts && pnpm readme"
  },
  "devDependencies": {
    "@types/node": "^26",
    "automd": "^0.4.3",
    "eslint-config-unjs": "^0.6.2",
    "nitro": "https://pkg.pr.new/nitro@4777",
    "oxfmt": ">=0.64.0",
    "oxlint": "^1.79.0",
    "vite": "^8.2.1"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.22.0"
}
